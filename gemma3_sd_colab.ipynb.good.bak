     "text": [
      "DataLoader phase=0 epoch=0 max_samples=8 shuffle=True seed=1234\n",
      "Dataset helper ready: warmup=10000, phaseB=10000, 7 buckets\n",
      "Non-overfit run: using generic VAL_PROMPTS for training validation grids.\n"
     ]
