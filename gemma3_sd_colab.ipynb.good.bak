     "text": [
      "CONDITIONING_ARCH = \"ella_gemma_connector\": skipping DualNativeAttention surgery.\n",
      "Original UNet cross-attention preserved; connector will provide encoder_hidden_states.\n",
      "  Stubs installed for dual_native symbols.\n"
     ]
