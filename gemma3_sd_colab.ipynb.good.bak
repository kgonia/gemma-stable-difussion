    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "  UNet cross_attention_dim: 768\n",
      "  UNet dtype: torch.float32\n",
      "  VAE dtype: torch.float32\n",
      "  Original CLIP-sized cross-attention remains intact, initialized from StyleJourney.\n"
     ]
